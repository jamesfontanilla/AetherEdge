# ==============================================================================
# AetherEdge Production Environment & Secrets Blueprint
# ==============================================================================
# WARNING: NEVER commit the filled version of this file (.env.production) to Git.
# Deploy these variables to Cloudflare Workers via:
#   wrangler secret put <KEY_NAME> --config apps/edge-gateway/wrangler.toml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PLATFORM & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-byte hex key for encrypting developer OAuth tokens & database connection secrets at rest
AETHER_MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT Signing Secret for platform session tokens and CLI authentication tokens
AETHER_JWT_SECRET="super-secret-jwt-signing-key-replace-in-prod"

# Base platform domains
AETHER_ROOT_DOMAIN="aether.run"
AETHER_GATEWAY_URL="https://gateway.aether.run"

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE INFRASTRUCTURE (Workers, D1, KV, DNS & SSL for SaaS)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="cf-api-token-with-workers-d1-kv-ssl-saas-permissions"

# Cloudflare for SaaS (Custom Apex Domains)
CLOUDFLARE_ZONE_ID="your-aether-run-zone-id"
CLOUDFLARE_FALLBACK_ORIGIN="apex.aether.run"

# Cloudflare AI Gateway
CLOUDFLARE_AI_GATEWAY_ID="aether-ai-proxy"

# ------------------------------------------------------------------------------
# 3. BACKBLAZE B2 (Zero-Egress Object Storage via Bandwidth Alliance)
# ------------------------------------------------------------------------------
# Generated in Backblaze B2 Console -> App Keys
B2_KEY_ID="your-backblaze-key-id"
B2_APPLICATION_KEY="your-backblaze-application-key"
B2_BUCKET_NAME="aether-storage-prod"
B2_BUCKET_ID="your-backblaze-bucket-id"
B2_BANDWIDTH_ALLIANCE_ENDPOINT="https://f000.backblazeb2.com"

# ------------------------------------------------------------------------------
# 4. AMAZON SES (Outbound Transactional Mail Relay)
# ------------------------------------------------------------------------------
# AWS IAM User credentials with policy restricted strictly to ses:SendEmail, ses:SendRawEmail
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# System Outbound Sender Email (Must be verified in SES with DKIM/SPF/DMARC)
AETHER_SYSTEM_FROM_EMAIL="notify@aether.run"

# AWS SNS Webhook Signing Secret (To track bounces, complaints, and protect IP reputation)
AWS_SNS_VERIFICATION_TOKEN="aws-sns-bounce-webhook-secret"

# ------------------------------------------------------------------------------
# 5. POSTVEIL & OAUTH FEDERATION (Sovereign Auth)
# ------------------------------------------------------------------------------
POSTVEIL_AUTH_ENDPOINT="https://auth.postveil.me"
POSTVEIL_CLIENT_ID="aetheredge-platform-client"
POSTVEIL_CLIENT_SECRET="postveil-oauth-federation-secret"

# GitHub OAuth App (For developer CLI and console sign-in)
GITHUB_CLIENT_ID="gh-oauth-app-client-id"
GITHUB_CLIENT_SECRET="gh-oauth-app-client-secret"

# ------------------------------------------------------------------------------
# 6. BILLING & FRAUD DEFENSE (Stripe & Turnstile)
# ------------------------------------------------------------------------------
# Stripe Secret Key for $25/mo Pro subscriptions and $0 fraud verification cards
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# Cloudflare Turnstile (Bot & Scraper defense on auth/deploy endpoints)
TURNSTILE_SITE_KEY="0x4AAAAAAXXXXXXXXXXXXXXX"
TURNSTILE_SECRET_KEY="0x4AAAAAAXXXXXXXXXXXXXXX"
