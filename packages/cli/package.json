{
  "name": "aether",
  "version": "1.0.0",
  "description": "AetherEdge CLI tool: npx aether deploy",
  "bin": {
    "aether": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --banner.js=\"#!/usr/bin/env node\"",
    "dev": "tsup src/cli.ts --watch"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
